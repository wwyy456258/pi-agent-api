{
  "name": "pi-agent-api",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi extension for synchronous HTTP chat, file attachments, model selection, and systemd/launchd background services",
  "license": "MIT",
  "author": { "name": "wwyy456258", "url": "https://github.com/wwyy456258" },
  "repository": { "type": "git", "url": "git+https://github.com/wwyy456258/pi-http.git" },
  "homepage": "https://github.com/wwyy456258/pi-http#readme",
  "bugs": { "url": "https://github.com/wwyy456258/pi-http/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "keywords": ["pi-package", "pi-extension", "http", "api", "chat", "file-upload", "systemd", "launchd"],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": { "extensions": ["./src/extension.ts"] },
  "bin": { "pi-agent-api-service": "scripts/service.mjs", "pi-http-service": "scripts/service.mjs" },
  "files": [
    "src",
    "scripts",
    "docs",
    "pi-agent-api.config.example.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "release:check": "npm run check && npm test && npm pack --dry-run",
    "prepublishOnly": "npm run release:check"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.4",
    "fastify": "5.12.7",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" }
}
