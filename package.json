{
  "name": "pi-http",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A synchronous HTTP interface for Pi agent sessions",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-http": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "pi-http.config.example.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@fastify/multipart": "10.1.4",
    "fastify": "5.12.7",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
